{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "jsx": "react-jsx",
    "jsxImportSource": "bsjd",
    "paths": {
      "bsjd/jsx-runtime": ["./build/runtime/runtime.ts"],
      "@foxcord/core/*": ["./src/*"],
      "@foxcord/*": ["../*/src/index.ts"]
    },
  },
  "include": ["src"]
}
